// module.modulemap — Clang module map so Swift can `import SankofaUpdaterFFI`
// directly from the SankofaUpdaterFFI.xcframework that build-ios.sh ships.
//
// The xcodebuild -create-xcframework -headers <dir> command copies every
// file in this directory into each slice's Headers/ subdir, including this
// modulemap. Xcode then exposes the umbrella header (sankofa_updater.h) as
// a Clang module the Swift compiler can resolve via `import`.
//
// Without this map, the static lib still links but Swift consumers have to
// fall back to @_silgen_name annotations or a bridging header. With it,
// SankofaUpdaterBridge.swift can just say `import SankofaUpdaterFFI` and
// call sankofa_updater_init(...) like any other C function.

// Plain `module` (not `framework module`) because the xcframework
// slices are static archives (libsankofa_updater_ffi.a), not
// Foo.framework bundles. `framework module` would tell Clang to look
// for headers at `Foo.framework/Headers/foo.h`; the static-lib layout
// puts the header directly in the slice's `Headers/` dir alongside
// this module map, which is what plain `module` resolves.
module SankofaUpdaterFFI {
    umbrella header "sankofa_updater.h"
    export *
    module * { export * }
}
